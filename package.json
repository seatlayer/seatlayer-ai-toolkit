{
  "name": "seatlayer-ai-toolkit",
  "version": "0.2.0",
  "description": "Agent skills and diagnostics for hosted, SDK, private-access, and server-side SeatLayer integrations.",
  "type": "module",
  "private": true,
  "bin": {
    "seatlayer-ai": "./scripts/cli.mjs"
  },
